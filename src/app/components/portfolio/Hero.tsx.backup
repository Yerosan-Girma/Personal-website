        transition={{ duration: 8, repeat: Infinity, ease: "easeInOut" }}
        className="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] sm:w-[800px] h-[300px] sm:h-[500px] bg-gradient-to-tr from-blue-500/25 via-cyan-400/20 to-indigo-500/20 rounded-full blur-[90px] pointer-events-none -z-10"
