              animate={{ opacity: 1, y: 0 }}
              transition={{ duration: 0.5, delay: 0.25 }}
              className="text-slate-600 dark:text-slate-300 text-base sm:text-lg md:text-xl leading-relaxed mb-7 max-w-2xl font-normal drop-shadow-sm"
            >
              Software Engineering student at{" "}
              <strong className="text-slate-900 dark:text-white font-semibold">Haramaya University</strong>{" "}
              with verified production experience building Ethiopia'"'"'s{" "}
              <strong className="text-slate-900 dark:text-white font-semibold">Kiray Bet</strong>{" "}
              rental marketplace,{" "}
              <strong className="text-slate-900 dark:text-white font-semibold">WabiSeminar Live</strong>, and{" "}
              <strong className="text-slate-900 dark:text-white font-semibold">Digital Equb</strong>{" "}
              fintech system.
            </motion.p>

            {/* Quick-Fact Credibility Ribbons */}
            <motion.div
              initial={{ opacity: 0, y: 14 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ duration: 0.5, delay: 0.3 }}
              className="flex flex-wrap items-center gap-2 sm:gap-3 mb-8 text-xs font-mono text-slate-600 dark:text-slate-300"
            >
              <div className="flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-white/90 dark:bg-white/[0.08] border border-slate-200/60 dark:border-white/15 shadow-sm backdrop-blur-sm">
                <Layers size={13} className="text-blue-600 dark:text-cyan-400" />
                <span className="font-semibold text-slate-800 dark:text-slate-200">6+ Production Apps</span>
              </div>
              <div className="flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-white/90 dark:bg-white/[0.08] border border-slate-200/60 dark:border-white/15 shadow-sm backdrop-blur-sm">
                <GraduationCap size={14} className="text-blue-600 dark:text-cyan-400" />
                <span>Haramaya Univ. SE</span>
              </div>
              <div className="flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-white/90 dark:bg-white/[0.08] border border-slate-200/60 dark:border-white/15 shadow-sm backdrop-blur-sm">
                <MapPin size={13} className="text-blue-600 dark:text-cyan-400" />
                <span>Addis Ababa, Ethiopia</span>
              </div>
            </motion.div>

            {/* Prominent CTAs */}
            <motion.div
              initial={{ opacity: 0, y: 16 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ duration: 0.5, delay: 0.35 }}
              className="flex flex-col sm:flex-row flex-wrap gap-3 items-stretch sm:items-center w-full mb-8"
            >
              <button
                onClick={() => scrollTo("projects")}
                className="h-13 px-7 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-sm shadow-lg shadow-blue-600/35 hover:shadow-blue-500/45 transition-all duration-200 flex items-center justify-center gap-2.5 cursor-pointer group shrink-0 active:scale-[0.98]"
              >
                <span>View Featured Projects</span>
                <ArrowRight size={16} className="transition-transform duration-200 group-hover:translate-x-1" />
              </button>

              <button
                onClick={onOpenResume}
