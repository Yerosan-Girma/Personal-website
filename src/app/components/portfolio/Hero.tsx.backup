                className="absolute -inset-4 bg-gradient-to-tr from-blue-600/35 via-cyan-400/25 to-indigo-600/25 rounded-[36px] blur-2xl -z-10"
              />

              {/* Photo Frame Container */}
              <div className="relative rounded-[32px] overflow-hidden bg-slate-900 border-2 border-slate-200/80 dark:border-white/15 shadow-2xl dark:shadow-black/50">
                <div className="relative aspect-[4/5] w-full overflow-hidden">
                  <img
                    src={heroImg}
                    alt="Yerosan Girma — Full Stack Software Engineer"
                    className="w-full h-full object-cover object-[center_18%] transition-transform duration-700 hover:scale-105"
                    loading="eager"
                  />
                  {/* Gradient Overlay */}
                  <div className="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/15 to-transparent pointer-events-none" />

                  {/* Top Status Tag */}
                  <div className="absolute top-4 left-4">
                    <span className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-slate-950/80 backdrop-blur-md border border-white/20 text-white text-[11px] font-mono font-medium shadow-sm">
                      <Sparkles size={11} className="text-cyan-400" />
                      <span>Software Engineer</span>
                    </span>
                  </div>

                  {/* Corner Badge */}
                  <div className="absolute bottom-4 left-4 right-4 p-4 rounded-2xl bg-slate-950/90 backdrop-blur-md border border-white/15 text-left shadow-lg">
