                    key={soc.label}
                    href={soc.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    className="w-10 h-10 rounded-xl bg-white/80 dark:bg-white/[0.1] border border-slate-200/80 dark:border-white/20 flex items-center justify-center text-slate-700 dark:text-slate-300 hover:text-blue-600 dark:hover:text-cyan-400 hover:border-blue-400/60 dark:hover:border-cyan-400/50 hover:-translate-y-0.5 transition-all duration-200 cursor-pointer shadow-sm backdrop-blur-sm"
                    aria-label={soc.label}
                  >
                    <soc.icon size={17} />
                  </a>
                ))}
              </div>
            </motion.div>
          </div>

          {/* Right Column: Premium Framed Visual - PROFILE PICTURE */}
          <div className="lg:col-span-5 flex flex-col items-center justify-center">
            <motion.div
