                className="h-13 px-5 rounded-xl bg-white/80 dark:bg-white/[0.08] hover:bg-slate-100 dark:hover:bg-white/[0.12] text-slate-700 dark:text-slate-200 border border-slate-200/80 dark:border-white/15 text-xs font-semibold transition-all duration-200 flex items-center justify-center gap-2 cursor-pointer shadow-sm shrink-0 active:scale-[0.98] backdrop-blur-sm"
              >
                {copied ? <Check size={15} className="text-emerald-500" /> : <Copy size={15} />}
                <span>{copied ? "Email Copied!" : "Copy Email"}</span>
