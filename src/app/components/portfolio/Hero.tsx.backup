import { useState, useEffect } from "react";
import { motion, AnimatePresence } from "motion/react";
import confetti from "canvas-confetti";
import {
  Github,
  Linkedin,
  Mail,
  ArrowRight,
  Code2,
  Check,
  Copy,
  FileText,
  MapPin,
  Sparkles,
  Layers,
  GraduationCap,
} from "lucide-react";
import heroImg from "../image/yeroimage1.jpg";

interface HeroProps {
  onOpenResume: () => void;
}

const ROLES = [
  "Full-Stack Software Engineer",
  "React & TypeScript Specialist",
  "Node.js & Express API Architect",
  "PostgreSQL & MongoDB Designer",
];

export function Hero({ onOpenResume }: HeroProps) {
  const [copied, setCopied] = useState(false);
  const [roleIndex, setRoleIndex] = useState(0);

  useEffect(() => {
    const timer = setInterval(() => {
      setRoleIndex((prev) => (prev + 1) % ROLES.length);
    }, 3200);
    return () => clearInterval(timer);
  }, []);

  const handleCopyEmail = (e: React.MouseEvent) => {
    navigator.clipboard?.writeText("yerosang463@gmail.com");
    setCopied(true);

    const rect = (e.currentTarget as HTMLElement).getBoundingClientRect();
    const x = (rect.left + rect.width / 2) / window.innerWidth;
    const y = (rect.top + rect.height / 2) / window.innerHeight;

    confetti({
      particleCount: 36,
      spread: 50,
      origin: { x, y },
      colors: ["#2563EB", "#38BDF8", "#10B981", "#6366F1"],
      ticks: 140,
      disableForReducedMotion: true,
    });

    setTimeout(() => setCopied(false), 2400);
  };

  const scrollTo = (id: string) => {
    const target = document.getElementById(id);
    if (!target) return;
    const lenis = (window as any).lenis;
    if (lenis) {
      lenis.scrollTo(target, { offset: -70 });
    } else {
      const yOffset = -70;
      const scrollYPos = target.getBoundingClientRect().top + window.pageYOffset + yOffset;
      window.scrollTo({ top: scrollYPos, behavior: "smooth" });
    }
  };

  return (
    <section
      id="home"
      className="relative min-h-screen w-full flex items-center justify-center overflow-hidden pt-20 pb-16"
    >
      {/* Tech Gradient Background with Grid Pattern */}
      <div
        className="absolute inset-0 opacity-50 dark:opacity-60 pointer-events-none"
        style={{
          background: `linear-gradient(135deg, rgba(6, 32, 82, 0.8) 0%, rgba(15, 23, 42, 0.7) 25%, rgba(55, 65, 81, 0.6) 50%, rgba(15, 23, 42, 0.7) 75%, rgba(6, 32, 82, 0.8) 100%),
                        linear-gradient(45deg, rgba(59, 130, 246, 0.15) 0%, rgba(34, 197, 94, 0.08) 50%, rgba(139, 92, 246, 0.15) 100%)`,
          backgroundSize: "100% 100%, 60px 60px",
          backgroundPosition: "0 0, 0 0",
          backgroundAttachment: "fixed",
        }}
      />

      {/* Animated Tech Grid Overlay */}
      <motion.div
        animate={{
          opacity: [0.15, 0.25, 0.15],
        }}
        transition={{ duration: 6, repeat: Infinity, ease: "easeInOut" }}
        className="absolute inset-0 pointer-events-none"
        style={{
          backgroundImage: `linear-gradient(0deg, transparent 24%, rgba(59, 130, 246, 0.08) 25%, rgba(59, 130, 246, 0.08) 26%, transparent 27%, transparent 74%, rgba(59, 130, 246, 0.08) 75%, rgba(59, 130, 246, 0.08) 76%, transparent 77%, transparent),
                            linear-gradient(90deg, transparent 24%, rgba(59, 130, 246, 0.08) 25%, rgba(59, 130, 246, 0.08) 26%, transparent 27%, transparent 74%, rgba(59, 130, 246, 0.08) 75%, rgba(59, 130, 246, 0.08) 76%, transparent 77%, transparent)`,
          backgroundSize: "50px 50px",
          backgroundPosition: "0 0",
        }}
      />

      {/* Dark Gradient Overlay for better text visibility */}
      <div className="absolute inset-0 bg-gradient-to-r from-white/95 via-white/85 to-white/70 dark:from-slate-950/92 dark:via-slate-900/85 dark:to-slate-950/75 pointer-events-none" />

      {/* Premium Animated Gradient Blobs */}
      <motion.div
        animate={{
          scale: [1, 1.08, 1],
          opacity: [0.5, 0.7, 0.5],
