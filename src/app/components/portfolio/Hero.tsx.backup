                  { icon: Github, href: "https://github.com/Yerosan-Girma", label: "GitHub" },
                  { icon: Linkedin, href: "https://www.linkedin.com/in/yerosan-girma-30005b37a", label: "LinkedIn" },
                  { icon: Mail, href: "mailto:yerosang463@gmail.com", label: "Email" },
                ].map((soc) => (
