              animate={{ opacity: 1, scale: 1, y: 0 }}
              transition={{ duration: 0.7, delay: 0.2, ease: [0.16, 1, 0.3, 1] }}
              className="relative w-full max-w-[300px] sm:max-w-[360px]"
            >
              {/* Outer Atmospheric Glow — animated */}
              <motion.div
                animate={{
