            </motion.div>

            {/* Social Connect Strip */}
            <motion.div
              initial={{ opacity: 0 }}
              animate={{ opacity: 1 }}
              transition={{ duration: 0.5, delay: 0.45 }}
              className="flex items-center gap-4 pt-5 border-t border-slate-200/80 dark:border-white/15 w-full"
            >
              <span className="text-slate-400 dark:text-slate-500 text-xs font-mono uppercase tracking-wider drop-shadow-sm">
